# 1.机器学习在处理图像和文本数据方面能力较弱
# CNN：最初为图像处理而生，分为卷积层、池化层、全连接层
# 卷积层：用卷积核对输入做局部滑动计算，提取边缘、纹理等局部特征
# 池化层：紧跟卷积层，通过最大值/平均值采样压缩数据维度，保留关键特征，减少计算量
# 全连接层：位于网络尾部，将卷积/池化提取的特征映射为一维向量，连接到输出层
# RNN：最初为文本数据而生，分为嵌入层，循环层、全连接层
# 嵌入层：将离散输入转换为低维稠密的词向量，提升特征表达能力
# 循环层：RNN核心，分为基础RNN、LSTM、GRU三类
# 全连接层：链接循环层输出，将序列（后面的数据对前面的数据有依赖）特征映射为目标维度
# Tensor -> ANN -> CNN（只能处理二维数据） -> RNN
# 2.深度学习的特点
# （1）多层非线性变换，（2）自动提取特征，（3）大数据和计算能力，（4）可解释性差
# 3.张量的基本创建
# （1）什么是张量？元素为同一种数据类型的多维矩阵
# （2）代码示例
import torch
def Tensor_learning():
    a = torch.tensor(7)
    print(a,type(a))
    print('-' * 30)
    b = torch.tensor([[1,2,3],[4,5,6]])
    print(b,type(b))
    print('-' * 30)
    c = torch.Tensor(2,3)  # 旧版写法，生成的是未初始化的随机值
    print(c)
    print('-' * 30)

# （3）torch.tensor 根据指定数据创建张量，torch.Tensor 根据指定数据创建张量，根据形状创建张量
# （4）张量的默认数据类型是float32，其可以在保证精度的前提下尽可能地节省空间

    d = torch.ones(2,3)  # 创建全1张量
    print(d,type(d))
    print('-' * 30)
    e = torch.ones_like(b)  # 基于b的形状创建全1张量
    print(e,type(e))
    print('-' * 30)
    f = torch.full_like(e,255)  # 创建全为指定值的张量
    print(f,type(f))
    print('-' * 30)
    g = torch.arange(5)  # 创建线性张量 tensor([0, 1, 2, 3, 4])
    print(g)
    h = torch.arange(0,10,2)  # tensor([0, 2, 4, 6, 8])
    print(h)
    print('-' * 30)
    i = torch.linspace(1,10,5)  # 创建指定范围的线性张量 tensor([ 1.0000,  3.2500,  5.5000,  7.7500, 10.0000])
    print(i)
    print('-' * 30)
    j = torch.rand(2,3)  # 创建随机张量
    print(j)
    print('-' * 30)
    k = torch.randn(2,3)  # 创建符合正态分布的随机张量
    print(k)
    print('-' * 30)
    l = torch.arange(5)
    m = l.type(torch.float)  # 类型转换
    print(l,'->',m)
    
if __name__ == "__main__":
    Tensor_learning()

import torch
import numpy as np
def Tensor_learning():
    t1 = torch.tensor([1,2,3,5])
    print(t1)
    t2 = t1.numpy()  # 共享内存
    t3 = t1.numpy().copy()  # 不共享内存
    t1[3] = 100
    print(t2)  # [  1   2   3 100]
    print(t3)  # [1 2 3 5]
    print('-' * 30)
    n1 = np.array([11,22,33])
    print(n1)
    n1 = torch.from_numpy(n1)  # 共享内存
    n2 = n1.detach().clone()  # 不共享内存
    n1[2] = 99
    print(n1)  # tensor([11, 22, 99], dtype=torch.int32)
    print(n2)  # tensor([11, 22, 33], dtype=torch.int32)
    print('-' * 30)
    m1 = torch.tensor(7.7)
    value = m1.item()  # 从标量张量中提取内容
    print(value,type(value))  # 7.699999809265137 <class 'float'>

if __name__ == "__main__":
      Tensor_learning()
