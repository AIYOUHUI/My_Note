<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>抽奖功能</title>
    <style>
        #btn {padding: 10px 20px;background: #ff4400;color: #fff;border: none;cursor: pointer;}
        #res {margin: 20px 0;}
        #img {display: none; max-width: 300px; height: auto; margin: 0 auto;}
    </style>
</head>
<body align="center">
    <button id="btn">抽奖</button>
    <div id="res"></div>
    <img id="img" src="./01.png">
    <script>
        document.getElementById('btn').onclick = function() {
            let nums = [];
            while(nums.length < 5) {
                let num = Math.floor(Math.random()*100)+1;
                if(!nums.includes(num)) nums.push(num);
            }
            document.getElementById('res').innerText = '恭喜以下用户获得一等奖：' + nums.join(',');
            document.getElementById('img').style.display = 'block';
        };
    </script>
</body>
</html>
