<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>ducument</title>
        <style>
            #button {
                padding:20px 30px;
                background:#ff4400;
                color:white;
                border:none;
                border-radius:5px;
                font-size:20px;
                cursor:pointer
            }

            #result {
                color:#d32f2f;
                margin:20px 0;
                font-size:25px;
            }

            #img {
                display:none;
                width:500px;
                margin:10px auto
            }
        </style>
    </head>
    <body align="center">
        <button id="button">抽奖</button>
        <div id="result"></div>
        <img id='img' src="./01.png">
        <script>
            document.getElementById('button').onclick = function() {
                let nums = [];
                while(nums.length<5) {
                    let randomnum = Math.floor(Math.random()*100) + 1;
                    if(!nums.includes(randomnum)) nums.push(randomnum);
                }
                document.getElementById('result').innerHTML = '恭喜以下用户获得一等奖<br>'+ nums.join(',') + '<br>' + '中奖啦！';
                document.getElementById('img').style.display = 'block';
            };
        </script>
    </body>
</html>
