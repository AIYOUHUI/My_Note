<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <!-- CSS是一种样式表语言，用来描述HTML文档的呈现 -->
    <!-- <style>
        p {
            color:blue;
            font-size:30px;
        }
    </style> -->

    <!-- CSS引入方式：内部样式表：CSS代码写在style标签里面  外部样式表：CSS代码写在单独的CSS文件中，使用link标签引入  行内样式：CSS写在标签的style属性值里 -->
    <link rel="stylesheet" href="./01.css">

    <!-- 标签选择器：使用标签名作为选择器，选中同名标签设置相同的样式 -->
    <style>
        p {
            color:green;
        }
    </style>

    <!-- 类选择器：查找标签，差异化设置标签的显示效果 -->
    <style>
        .red {
            color: red;
        }
        .font-size {
            font-size: 50px;
        }
    </style>

    <!-- id选择器：查找标签，差异化设置标签的显示效果，一般配合js使用 -->
    <style>
        #yellow {
            color: yellow;
        }
    </style>
</head>
<body>
    <p>我好帅</p>
    <p class="red font-size">哈哈哈</p>
    <div style="color: blue; font-size:30px ;">我好帅</div>
    <div class="red" style="font-size: 30px;">你好</div>
    <div id="yellow" class="font-size">这是黄色</div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
    /* 通配符选择器：查找页面所有标签，设置相同样式 */
    * {
        color:black;
    }
    </style>

    <style>
        .red {
            width: 100px;
            height: 100px;
            background-color: brown;
        }
        .orange {
            width: 100px;
            height: 100px;
            background-color: blue;
        }
    </style>
</head>
<body>
    <p>你是谁</p><hr>
    <p>我是小六</p>
    <p>看见mono了吗</p>

    <!-- 属性：width：宽度  height：高度  background-color：背景色 -->
    <div class="red">div1</div>
    <div class="orange">div2</div>
</body>
</html>

// number是一个标志符，但不能以数字开头，不能用关键字作为标志符
