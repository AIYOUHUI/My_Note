<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>用户注册</title>
    <style>
        h3 {font-family: 宋体; font-size: 1.75em; text-align: center;}
        form {margin: 0 auto; width: 300px; line-height: 2;}
        label {display: inline-block; width: 80px;}
    </style>
</head>
<body>
    <h3>用户注册</h3>
    <form onsubmit="return check()">
        <p><label>用户名：</label><input type="text" id="u"></p>
        <p><label>密码：</label><input type="password" id="p"></p>
        <p><label>重复密码：</label><input type="password" id="rp"></p>
        <p><label>性别：</label><input type="radio" name="g" checked value="男">男<input type="radio" name="g" value="女">女</p>
        <p><label>教育水平：</label>
            <select id="e">
                <option>博士</option><option>硕士</option><option selected>本科</option><option>大专</option><option>其他</option>
            </select>
        </p>
        <p><button type="submit">提交</button><button type="reset">重置</button></p>
    </form>
    <script>
        function check() {
            let u = document.getElementById('u').value;
            let p = document.getElementById('p').value;
            let rp = document.getElementById('rp').value;
            let g = document.querySelector('input[name="g"]:checked').value;
            let e = document.getElementById('e').value;
            if(!u) {alert("用户名为空"); return false;}
            if(!p) {alert("密码为空"); return false;}
            if(!rp) {alert("重复密码为空"); return false;}
            if(p!==rp) {alert("密码不一致"); return false;}
            alert("用户名：" + u + "\n密码：" + p + "\n性别：" + g + "\n教育水平：" + e);
            alert("注册成功！");
            return false;
        }
    </script>
</body>
</html>
